# Payment routes stay disabled until you provide testnet receiving addresses.
# PAY_TO must be your Mezo Testnet merchant address; never add a private key here.
PAY_TO=

# Optional. Must be a different Mezo Testnet address from PAY_TO.
SPONSOR_TO=

# Optional app configuration. These endpoints are pinned to Mezo Testnet.
PORT=4021
PRICE_USD=0.001
SPONSOR_PRICE_USD=0.01
MEZO_TESTNET_RPC=https://rpc.test.mezo.org
FACILITATOR_URL=https://facilitator.vativ.io
DATA_DIR=.data
